pipeline {

    agent {
        label 'i27-helpdesk-agent'
    }

    environment {
        AWS_REGION     = 'ap-south-2'
        ECR_REPOSITORY = 'i27-helpdesk/notification-service'
        K8S_NAMESPACE  = 'i27-helpdesk-dev'
        KUBECONFIG     = '/home/jenkins/.kube/config'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    echo "===== REPOSITORY ====="
                    git remote -v

                    echo "===== COMMIT ====="
                    git log -1 --oneline
                '''
            }
        }

        stage('Python Validation') {
            steps {
                sh '''
                    set -eu

                    echo "===== PYTHON ====="
                    python3 --version

                    echo "===== CREATE VIRTUAL ENVIRONMENT ====="
                    rm -rf .venv
                    python3 -m venv .venv

                    . .venv/bin/activate

                    echo "===== INSTALL DEPENDENCIES ====="
                    python -m pip install --upgrade pip
                    python -m pip install -r requirements.txt

                    echo "===== PYTHON COMPILE CHECK ====="
                    python -m compileall -q app

                    echo "Python validation successful ✅"
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQubeScanner'

                    withSonarQubeEnv('i27-sonarqube') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \
                              -Dsonar.projectKey=i27-helpdesk-notification-service \
                              -Dsonar.projectName=i27-helpdesk-notification-service \
                              -Dsonar.sources=app \
                              -Dsonar.python.version=3.10
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()

                    env.AWS_ACCOUNT_ID = sh(
                        script: 'aws sts get-caller-identity --query Account --output text',
                        returnStdout: true
                    ).trim()

                    env.ECR_REGISTRY =
                        "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"

                    env.IMAGE_URI =
                        "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}"
                }

                sh '''
                    echo "===== DOCKER BUILD ====="
                    echo "Image: ${IMAGE_URI}"

                    docker build \
                      -t "${IMAGE_URI}" \
                      .
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    set -eu

                    echo "===== ECR LOGIN ====="

                    aws ecr get-login-password \
                      --region "${AWS_REGION}" |
                    docker login \
                      --username AWS \
                      --password-stdin \
                      "${ECR_REGISTRY}"

                    echo "===== PUSH IMAGE ====="

                    docker push "${IMAGE_URI}"

                    echo "Successfully pushed:"
                    echo "${IMAGE_URI}"
                '''
            }
        }

        stage('Verify ECR Image') {
            steps {
                sh '''
                    aws ecr describe-images \
                      --repository-name "${ECR_REPOSITORY}" \
                      --region "${AWS_REGION}" \
                      --image-ids imageTag="${IMAGE_TAG}" \
                      --query 'imageDetails[0].{Tags:imageTags,Digest:imageDigest,Pushed:imagePushedAt}' \
                      --output table
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                    set -eu

                    echo "===== DEPLOY NOTIFICATION TO EKS ====="
                    echo "Image: ${IMAGE_URI}"

                    RENDERED_MANIFEST=$(mktemp)

                    cleanup() {
                        rm -f "${RENDERED_MANIFEST}"
                    }

                    trap cleanup EXIT

                    sed "s|__IMAGE_URI__|${IMAGE_URI}|g" \
                      k8s/aws/deployment.yaml \
                      > "${RENDERED_MANIFEST}"

                    if grep -q '__IMAGE_URI__' "${RENDERED_MANIFEST}"; then
                        echo "ERROR: Image placeholder was not replaced"
                        exit 1
                    fi

                    echo "===== VALIDATE MANIFEST ====="

                    kubectl apply \
                      --dry-run=client \
                      -f "${RENDERED_MANIFEST}"

                    echo "===== APPLY CONFIGMAP ====="

                    kubectl apply \
                      -f k8s/aws/configmap.yaml

                    echo "===== APPLY SERVICE ====="

                    kubectl apply \
                      -f k8s/aws/service.yaml

                    echo "===== APPLY DEPLOYMENT ====="

                    kubectl apply \
                      -f "${RENDERED_MANIFEST}"

                    echo "===== WAIT FOR ROLLOUT ====="

                    kubectl rollout status \
                      deployment/i27-helpdesk-notification \
                      -n "${K8S_NAMESPACE}" \
                      --timeout=240s

                    echo "===== VERIFY IMAGE ====="

                    DEPLOYED_IMAGE=$(kubectl get deployment \
                      i27-helpdesk-notification \
                      -n "${K8S_NAMESPACE}" \
                      -o jsonpath='{.spec.template.spec.containers[0].image}')

                    echo "Expected: ${IMAGE_URI}"
                    echo "Deployed: ${DEPLOYED_IMAGE}"

                    if [ "${DEPLOYED_IMAGE}" != "${IMAGE_URI}" ]; then
                        echo "ERROR: deployed image does not match"
                        exit 1
                    fi

                    echo "===== STATUS ====="

                    kubectl get pods \
                      -n "${K8S_NAMESPACE}" \
                      -l app=i27-helpdesk-notification \
                      -o wide

                    kubectl get service \
                      i27-helpdesk-notification \
                      -n "${K8S_NAMESPACE}"

                    echo "Notification deployment successful ✅"
                '''
            }
        }
    }

    post {
        success {
            echo 'Notification Service AWS CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'Notification Service pipeline failed. Check the failed stage.'
        }

        always {
            sh 'rm -rf .venv || true'
            echo 'Pipeline execution finished.'
        }
    }
}
